# 9Router (LiteLLM — PRINCIPAL): N chaves (auto-escala 1..9)
LITELLM_API_KEY_9ROUTER=
# LITELLM_API_KEY_9ROUTER_2=
# LITELLM_API_KEY_9ROUTER_3=
LITELLM_MODEL_PRIMARY=openai/gpt-4o-mini
LITELLM_MODEL_FALLBACK=openai/gpt-4o-mini
# OpenRouter (Hub): N chaves de e-mails diferentes — limites independentes (50/dia cada)
# O sistema gira base -> _2 -> _3 automaticamente em 401/429/402/403
LITELLM_API_KEY_OPENROUTER=
# LITELLM_API_KEY_OPENROUTER_2=
# LITELLM_API_KEY_OPENROUTER_3=
# OPENROUTER_API_KEY= (alias aceito)

# Diretas — cada provider suporta _2.._9 (ex.: GROQ_API_2, MISTRAL_API_2)
MISTRAL_API=
GROQ_API=
# GROQ_API_2= (2ª conta)
NVIDIA_API=
POLINAI_API=
# GROK_API= (xAI, formato xai-...)

# Legado / reservas
API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
ERNIE_API_KEY=
MOONSHOT_API_KEY=
YI_API_KEY=
ZHIPU_API_KEY=
GROK_API_KEY=
HYPERCLOVA_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=
GROQ_API_KEY=
META_API_KEY=

DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
APP_ENV=local
